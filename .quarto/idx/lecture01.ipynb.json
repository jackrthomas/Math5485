{"title":"Introduction","markdown":{"yaml":{"title":"Introduction","format":{"html":"default","pdf":"default"}},"headingText":"Subheading","containsRefs":false,"markdown":"\n\n<div class=\"custom-lecture-buttons my-3 d-flex gap-2\">\n  <a href=\"#\" class=\"btn-download-ipynb btn btn-outline-primary btn-sm\" target=\"_blank\">\n    <i class=\"bi bi-journal-code\"></i> Download (.ipynb)\n  </a>\n  <a href=\"#\" class=\"btn-ask-question btn btn-outline-secondary btn-sm\" target=\"_blank\">\n    <i class=\"bi bi-question-circle\"></i> Ask a Question\n  </a>\n</div>\n\n<script>\n(function() {\n  // Extract notebook file name from current page\n  var path = window.location.pathname.replace(/\\/$/, \"\");\n  var page = path.split(\"/\").pop().replace(/\\.html$/, \"\") || \"lecture01\";\n  \n  // 1. Set Raw Notebook Download URL\n  var rawNotebookUrl = \"https://raw.githubusercontent.com/jackrthomas/Math5485/main/\" + page + \".ipynb\";\n  var downloadBtn = document.querySelector(\".btn-download-ipynb\");\n  if (downloadBtn) {\n    downloadBtn.setAttribute(\"href\", rawNotebookUrl);\n  }\n\n  // 2. Set Ask a Question URL with current page title & URL pre-filled\n  var pageTitle = encodeURIComponent(\"[Question] \" + (document.title || page));\n  var currentUrl = encodeURIComponent(window.location.href);\n  var issueBody = encodeURIComponent(\"**Reference Page:** \" + decodeURIComponent(currentUrl) + \"\\n\\n**Question/comment:**\\n[Your question/query/suggestion/comment here]\");\n  \n  var issueUrl = \"https://github.com/jackrthomas/Math5485/issues/new?template=question.md&title=\" + pageTitle + \"&body=\" + issueBody;\n  \n  var questionBtn = document.querySelector(\".btn-ask-question\");\n  if (questionBtn) {\n    questionBtn.setAttribute(\"href\", issueUrl);\n  }\n})();\n</script>\n\n@knuth84\n\n\n<button onclick=\"window.scrollTo({top: 0, behavior: 'smooth'});\" \n        class=\"btn btn-dark btn-sm rounded-circle shadow position-fixed bottom-0 end-0 m-4 d-flex align-items-center justify-content-center\" \n        style=\"width: 42px; height: 42px; z-index: 1050;\" \n        title=\"Go to Top\">\n  <i class=\"bi bi-arrow-up fs-5\"></i>\n</button>\n","srcMarkdownNoYaml":"\n\n<div class=\"custom-lecture-buttons my-3 d-flex gap-2\">\n  <a href=\"#\" class=\"btn-download-ipynb btn btn-outline-primary btn-sm\" target=\"_blank\">\n    <i class=\"bi bi-journal-code\"></i> Download (.ipynb)\n  </a>\n  <a href=\"#\" class=\"btn-ask-question btn btn-outline-secondary btn-sm\" target=\"_blank\">\n    <i class=\"bi bi-question-circle\"></i> Ask a Question\n  </a>\n</div>\n\n<script>\n(function() {\n  // Extract notebook file name from current page\n  var path = window.location.pathname.replace(/\\/$/, \"\");\n  var page = path.split(\"/\").pop().replace(/\\.html$/, \"\") || \"lecture01\";\n  \n  // 1. Set Raw Notebook Download URL\n  var rawNotebookUrl = \"https://raw.githubusercontent.com/jackrthomas/Math5485/main/\" + page + \".ipynb\";\n  var downloadBtn = document.querySelector(\".btn-download-ipynb\");\n  if (downloadBtn) {\n    downloadBtn.setAttribute(\"href\", rawNotebookUrl);\n  }\n\n  // 2. Set Ask a Question URL with current page title & URL pre-filled\n  var pageTitle = encodeURIComponent(\"[Question] \" + (document.title || page));\n  var currentUrl = encodeURIComponent(window.location.href);\n  var issueBody = encodeURIComponent(\"**Reference Page:** \" + decodeURIComponent(currentUrl) + \"\\n\\n**Question/comment:**\\n[Your question/query/suggestion/comment here]\");\n  \n  var issueUrl = \"https://github.com/jackrthomas/Math5485/issues/new?template=question.md&title=\" + pageTitle + \"&body=\" + issueBody;\n  \n  var questionBtn = document.querySelector(\".btn-ask-question\");\n  if (questionBtn) {\n    questionBtn.setAttribute(\"href\", issueUrl);\n  }\n})();\n</script>\n\n@knuth84\n\n## Subheading\n\n<button onclick=\"window.scrollTo({top: 0, behavior: 'smooth'});\" \n        class=\"btn btn-dark btn-sm rounded-circle shad